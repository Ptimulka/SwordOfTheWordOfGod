# Copy this file to keystore.properties (which is gitignored) and fill in real values.
# Used by app/build.gradle.kts to sign release builds.
#
# storeFile: absolute path to your upload keystore. Use forward slashes on Windows,
# and escape the drive-letter colon (C\:) to satisfy the .properties format.
storeFile=C\:/Users/you/path/to/upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
